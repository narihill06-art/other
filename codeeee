<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Paperboy Arcade</title>

<style>
* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #fff9e9;
  color: #111;
}

/* TOP NAVIGATION */
header {
  background: #073967;
  color: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 5%;
  gap: 20px;
  flex-wrap: wrap;
}

.logo {
  font-size: 37px;
  font-weight: 900;
  color: white;
  text-shadow: 3px 3px black;
}

nav {
  background: #062746;
  border-radius: 9px;
  display: flex;
  gap: 4px;
  flex-wrap: wrap;
}

nav a {
  padding: 13px 18px;
  color: white;
  text-decoration: none;
  font-weight: bold;
  font-size: 15px;
}

nav a:hover,
nav a.active {
  background: #f13b43;
  border-radius: 8px;
}

/* PAPERBOY BANNER */
.banner {
  position: relative;
  background: #2489b7;
}

.banner img {
  width: 100%;
  display: block;
}

.click-area {
  position: absolute;
  left: 44%;
  top: 64%;
  width: 23%;
  height: 21%;
}

/* WELCOME SECTION */
.welcome {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 14px 4%;
}

.welcome-text {
  flex: 1.25;
}

h1 {
  font-size: 27px;
  margin: 0 0 10px;
  border-bottom: 4px solid #f23c4c;
  padding-bottom: 9px;
}

.welcome p {
  font-size: 13px;
  line-height: 1.7;
}

.newspaper {
  width: 22%;
  max-width: 240px;
}

/* FOUR GAME BUTTONS */
.shortcuts {
  background: #07538f;
  color: white;
  border-radius: 11px;
  padding: 13px;
  flex: 1;
  min-width: 310px;
  text-align: center;
}

.shortcuts h2 {
  margin: 0 0 12px;
  font-size: 18px;
}

.shortcut-links {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.shortcut-links a {
  color: white;
  text-decoration: none;
  font-size: 12px;
  font-weight: bold;
}

.shortcut-links span {
  display: block;
  font-size: 30px;
  margin-bottom: 4px;
}

/* MEET OUR TEAM */
.team {
  background: #063461;
  padding: 12px 2.5% 22px;
}

.team h2 {
  color: #ff4556;
  font-size: 25px;
}

.members {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}

.member {
  background: #fff8e7;
  border: 3px solid #172536;
  border-radius: 8px;
  padding: 12px;
  display: flex;
  gap: 10px;
  min-height: 155px;
}

.member img,
.photo {
  width: 80px;
  height: 115px;
  object-fit: cover;
  flex-shrink: 0;
  background: #ddd9ce;
  border: 2px solid #222;
  border-radius: 4px;
}

.photo {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
}

.member h3 {
  font-size: 15px;
  margin: 0 0 7px;
}

.member p {
  font-size: 12px;
  line-height: 1.35;
}

.member a {
  background: #f13544;
  color: white;
  text-decoration: none;
  border-radius: 4px;
  padding: 7px 12px;
  font-size: 11px;
  font-weight: bold;
  display: inline-block;
}

/* OTHER SECTIONS */
.extra {
  padding: 26px 5%;
  background: #fff9e9;
}

.extra h2 {
  color: #073967;
}

footer {
  background: #062746;
  text-align: center;
  color: white;
  padding: 17px;
  font-size: 12px;
}

/* MOBILE LAYOUT */
@media (max-width: 950px) {
  .welcome {
    flex-wrap: wrap;
  }

  .shortcuts {
    flex-basis: 100%;
  }

  .members {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 550px) {
  header {
    justify-content: center;
  }

  nav {
    justify-content: center;
  }

  nav a {
    font-size: 12px;
    padding: 9px;
  }

  .welcome {
    display: block;
  }

  .newspaper {
    display: none;
  }

  .shortcuts {
    min-width: 0;
  }

  .members {
    grid-template-columns: 1fr;
  }
}
</style>
</head>

<body>

